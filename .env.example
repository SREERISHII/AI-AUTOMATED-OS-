# SMTP settings remain on your computer. For Gmail, use an App Password,
# never your normal account password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# Change this only after running: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
